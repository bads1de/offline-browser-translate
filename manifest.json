{
  "manifest_version": 3,
  "name": "Local LLM Translator",
  "version": "2.2.3",
  "description": "Privacy-focused translation using local LLMs (Ollama, LMStudio, or any OpenAI-compatible server such as llama.cpp). Your data never leaves your machine.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [{
    "resources": ["icons/icon48.png"],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "settings.js",
      "languages.js",
      "cache.js",
      "provider-transport.js",
      "pdf/paragraphs.js",
      "pdf/pdf-store.js",
      "background/core.js",
      "background/providers.js",
      "background/settings-store.js",
      "background/glossary.js",
      "background/prompt.js",
      "background/translate.js",
      "background/content-injection.js",
      "background/captions-bridge.js",
      "background/pdf-bridge.js",
      "background/messages.js",
      "background/lifecycle.js",
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Alt+A" },
      "description": "Translate the page, or put the original back"
    },
    "toggle-translation": {
      "suggested_key": { "default": "Alt+B" },
      "description": "Switch between translated and original text"
    },
    "translate-selection": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Translate the selected text"
    },
    "translate-compose": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Translate the text in the focused field"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "local-llm-translator@privacy.extension",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  }
}
